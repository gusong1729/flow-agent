  "nodes": [
    {
      "id": "n1",
      "label": "接到甲方数据需求",
      "kind": "start",
      "owner": "项目统筹",
      "status": "done",
      "detail": "先问清：场景类型、动作内容、数据类型、数量或时长、质量要求、交付时间"
    },
    {
      "id": "n2",
      "label": "把需求写成验收标准",
      "kind": "task",
      "owner": "项目统筹",
      "status": "done",
      "detail": "哪些算合格、哪些算废片、按什么单位计量（本业务按有效时长结算）",
      "note": "需求没写清，后面验收和结算一定扯皮——这是全流程的第一道闸"
    },
    {
      "id": "n3",
      "label": "报价签约",
      "kind": "task",
      "owner": "项目统筹",
      "status": "todo",
      "detail": "约定单价、结算口径、付款方式、验收标准；明确设备与场景由甲方提供还是自建执行",
      "note": "单价与规模以合同为准，图上不写示例数字"
    },
    {
      "id": "n4",
      "label": "小批量试采验证",
      "kind": "task",
      "owner": "项目统筹",
      "status": "todo",
      "detail": "先做小批量，双方对齐标准；这一步也是在验证我方有没有交付能力",
      "note": "试采不通过就别放量，否则返工成本全在自己身上"
    },
    {
      "id": "n5",
      "label": "试采验收是否通过",
      "kind": "decision",
      "owner": "甲方",
      "status": "todo",
      "detail": "判据：甲方按约定的验收标准逐条确认通过"
    },
    {
      "id": "n6",
      "label": "确认场景可用",
      "kind": "task",
      "owner": "项目统筹",
      "status": "todo",
      "detail": "联系真实场所，确认位置、开放时间、采集许可、可摆放空间",
      "note": "场地没落实就排人，等于让采集员白跑"
    },
    {
      "id": "n7",
      "label": "人员培训",
      "kind": "task",
      "owner": "组长",
      "status": "todo",
      "detail": "设备佩戴与操作、采集规范、安全要求、异常上报方式；培训后让人试做一遍",
      "note": "培训不到位，现场问题会集中爆发，质检和结算全跟着受影响"
    },
    {
      "id": "n8",
      "label": "设备准备与备机",
      "kind": "task",
      "owner": "技术",
      "status": "todo",
      "detail": "可用性、电量、存储、网络；按台数配比准备备用设备"
    },
    {
      "id": "n9",
      "label": "排期",
      "kind": "task",
      "owner": "组长",
      "status": "todo",
      "detail": "按场景分布与人员数量排每日计划：哪个点位、几人、几台设备、目标有效时长"
    },
    {
      "id": "n10",
      "label": "按标准现场采集",
      "kind": "task",
      "owner": "采集员",
      "status": "todo",
      "detail": "角度、光线、动作、时长、数量都要符合验收标准（具体动作见对应任务单）"
    },
    {
      "id": "n11",
      "label": "过程记录",
      "kind": "task",
      "owner": "采集员",
      "status": "todo",
      "detail": "时间、场景、设备编号、人员、采集量；现场情况当场记，不要晚上靠回忆补"
    },
    {
      "id": "n12",
      "label": "出现异常？",
      "kind": "decision",
      "owner": "采集员",
      "status": "todo",
      "detail": "设备故障 / 现场变化 / 数据异常，任一命中就走异常分支"
    },
    {
      "id": "n13",
      "label": "上报并现场处置",
      "kind": "risk",
      "owner": "项目统筹",
      "status": "risk",
      "detail": "先记录现象与已试过的动作，再决定换机、改期还是换点位",
      "note": "现场问题不记录，后面质检对不上账时无法定位原因"
    },
    {
      "id": "n14",
      "label": "当日目标是否达成",
      "kind": "decision",
      "owner": "组长",
      "status": "todo",
      "detail": "判据：当日计划的有效时长目标是否达到（不是拍了几小时，是合格几小时）"
    },
    {
      "id": "n15",
      "label": "当天上传数据",
      "kind": "task",
      "owner": "采集员",
      "status": "todo",
      "detail": "当天归集，避免丢失和积压；上传后确认文件可读",
      "note": "攒到第二天再传，出问题就说不清是哪天的"
    },
    {
      "id": "n16",
      "label": "登记台账",
      "kind": "task",
      "owner": "项目统筹",
      "status": "todo",
      "detail": "谁采的、在哪采的、用哪台设备、采了多少时长、有没有问题",
      "note": "台账是质检、结算、复盘的数据基础，漏一行后面全靠猜"
    },
    {
      "id": "n17",
      "label": "完整性检查",
      "kind": "milestone",
      "owner": "项目统筹",
      "status": "todo",
      "detail": "数量、格式、场景信息是否齐全；与排期计划对一遍有无漏报"
    },
    {
      "id": "n18",
      "label": "按甲方标准质检",
      "kind": "task",
      "owner": "质检",
      "status": "todo",
      "detail": "清晰度、角度、场景、时长、内容合规性；标准必须与甲方一致",
      "note": "质检口径一旦比甲方宽，结算时被打回的就是自己"
    },
    {
      "id": "n19",
      "label": "剔除无效数据",
      "kind": "task",
      "owner": "质检",
      "status": "todo",
      "detail": "按废片判据逐条剔除，形成合格数据包；每条剔除都要有原因"
    },
    {
      "id": "n20",
      "label": "统计有效时长",
      "kind": "milestone",
      "owner": "项目统筹",
      "status": "todo",
      "detail": "按天、按场景、按采集人员分别统计——这是结算依据",
      "note": "全流程的账最终都落在这一格上，不是落在采集总时长上"
    },
    {
      "id": "n21",
      "label": "与台账核对",
      "kind": "task",
      "owner": "项目统筹",
      "status": "todo",
      "detail": "采集记录 vs 质检结果，定位数据量差异出在哪一天、哪个人、哪个点位"
    },
    {
      "id": "n22",
      "label": "差异是否可解释",
      "kind": "decision",
      "owner": "项目统筹",
      "status": "todo",
      "detail": "判据：每条差异都能指到具体原因（设备、遮挡、漏拍、上传缺失）"
    },
    {
      "id": "n21b",
      "label": "补正台账记录",
      "kind": "risk",
      "owner": "项目统筹",
      "status": "risk",
      "detail": "按采集记录与上传清单把台账补齐或更正，再回到核对",
      "note": "台账补不出来的，就是真差异，要在交付前说明"
    },
    {
      "id": "n23",
      "label": "按约定交付",
      "kind": "task",
      "owner": "项目统筹",
      "status": "todo",
      "detail": "格式、时间、方式符合甲方要求；交付前自查一遍命名与目录结构"
    },
    {
      "id": "n24",
      "label": "甲方确认验收",
      "kind": "milestone",
      "owner": "甲方",
      "status": "todo",
      "detail": "保留交付记录与验收确认；被打回的条目单独列出并安排补采"
    },
    {
      "id": "n25",
      "label": "按有效时长对账",
      "kind": "task",
      "owner": "项目统筹",
      "status": "todo",
      "detail": "有效时长 × 结算单价；把差异说明附在对账单后面"
    },
    {
      "id": "n26",
      "label": "结算留底",
      "kind": "task",
      "owner": "项目统筹",
      "status": "todo",
      "detail": "交付单、验收单、结算明细归档",
      "note": "留底不全，之后对账有争议时只能吃哑巴亏"
    },
    {
      "id": "n27",
      "label": "对比计划与有效时长",
      "kind": "task",
      "owner": "项目统筹",
      "status": "todo",
      "detail": "计划目标 vs 实际合格量，按点位/人员/设备拆开看"
    },
    {
      "id": "n28",
      "label": "分析差异出在哪",
      "kind": "task",
      "owner": "项目统筹",
      "status": "todo",
      "detail": "培训、设备、场景还是标准理解的问题；落到具体环节，不写「执行不到位」"
    },
    {
      "id": "n29",
      "label": "更新流程与培训材料",
      "kind": "task",
      "owner": "项目统筹",
      "status": "todo",
      "detail": "把这次踩的坑写进任务单模板、培训卡与异常决策树"
    },
    {
      "id": "n30",
      "label": "沉淀可复用标准",
      "kind": "task",
      "owner": "项目统筹",
      "status": "todo",
      "detail": "同一场景第二单不应再从头试错"
    },
    {
      "id": "t",
      "label": "进入长期订单",
      "kind": "end",
      "owner": "甲方",
      "status": "todo",
      "detail": "试采验收通过后放量；每一轮回到「现场采集」继续跑"
    }
  ],
