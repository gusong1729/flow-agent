{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowAgent",
  "version": "0.1.1",
  "identifier": "com.ohworkspace.flowagent",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "node tools/sync-samples.mjs && node tools/build-static.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
