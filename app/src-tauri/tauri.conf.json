{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowAgent",
  "version": "0.1.0",
  "identifier": "com.ohworkspace.flowagent",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "node tools/sync-samples.mjs && node tools/build-static.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "流程图agent · 数采任务统筹",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
