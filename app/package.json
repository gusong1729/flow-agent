{
  "name": "flow-agent",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "数采任务统筹 Agent：对话生成任务单，右侧实时出图",
  "scripts": {
    "dev": "node tools/serve-dev.mjs 5183",
    "build": "node tools/sync-samples.mjs && node tools/build-static.mjs",
    "samples": "node tools/sync-samples.mjs",
    "renderer": "python tools/build-renderer.py",
    "test": "node --test tools/test-providers.mjs tools/test-llm.mjs && node tools/test-renderer.mjs",
    "test:unit": "node --test tools/test-providers.mjs tools/test-llm.mjs",
    "test:renderer": "node tools/test-renderer.mjs",
    "tauri": "tauri",
    "app": "node tools/build-static.mjs && cargo build --release --manifest-path src-tauri/Cargo.toml"
  }
}
